# Names of the settings the app needs. Real values go in Render → the service → Environment.
# Never put a real value in this file, in chat, or in a commit.

# App
APP_BASE_URL=
DATABASE_URL=
TOKEN_ENCRYPTION_KEY=

# Boutiqly private app (from the Boutiqly developer account)
BOUTIQLY_APP_ID=
BOUTIQLY_CLIENT_ID=
BOUTIQLY_CLIENT_SECRET=
BOUTIQLY_SHARED_SECRET=
BOUTIQLY_API_BASE=https://services.leadconnectorhq.com

# Wallet billing (Studio credits)
BOUTIQLY_CREDIT_METER_ID=
WALLET_BILLING_MODE=off
CREDIT_MARKUP=2

# Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
